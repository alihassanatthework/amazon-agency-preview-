# Origin of the deployed Express API, e.g. https://northbeam-api.onrender.com
# Leave unset in development — Vite proxies /api to localhost:4000.
VITE_API_URL=

# --- Form notifications (Vercel serverless functions in client/api) ---
# Both the contact form and the free-audit wizard email their submissions
# over SMTP. Set these in the Vercel project (Settings -> Environment
# Variables), never in a committed file. Names match server/.env.example so
# one set of credentials serves both backends.

# Mail host and port. 587 uses STARTTLS, 465 implicit TLS. Required.
SMTP_HOST=
SMTP_PORT=587

# The mailbox to authenticate as, and its password. For Gmail/Google
# Workspace and Microsoft 365 this must be a generated app password, not the
# account password. Required.
SMTP_USER=
SMTP_PASS=

# Optional. Envelope sender; defaults to SMTP_USER. Most providers reject a
# From that is not the authenticated mailbox, so usually leave this unset.
LEAD_NOTIFY_FROM=

# Optional. Where submissions are delivered. Defaults to
# blakegale@blazonpros.com when unset; set this only to route them elsewhere.
LEAD_NOTIFY_TO=
