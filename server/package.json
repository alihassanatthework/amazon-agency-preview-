{
  "name": "northbeam-server",
  "version": "1.0.0",
  "description": "Express + Mongoose API for the contact page audit request form",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/migrations/001_init.sql",
    "seed": "node src/db/seeds/seed_content.js",
    "seed:admin": "node src/db/seeds/seed_admin.js"
  },
