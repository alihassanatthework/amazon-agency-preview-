NODE_ENV=development
PORT=4000

# PostgreSQL. Create with: createdb blazon_dev && npm run migrate && npm run seed
DATABASE_URL=postgresql://localhost:5432/blazon_dev

# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:5173

# Optional. Without SMTP a lead is still persisted and surfaces in the admin
# inbox as notify_status='failed' — it is never silently lost.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
